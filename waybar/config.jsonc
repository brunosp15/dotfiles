{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [],
    "modules-right": [
        "group/tray-expander",
        "custom/sep",
        "memory",
        "cpu",
        "custom/sep",
        "bluetooth",
        "network",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "clock",
    ],
    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "1",
            "2": "2",
            "3": "3",
            "4": "4",
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
        }
    },
    "cpu": {
        "interval": 5,
        "format": " cpu {usage}% ",
        "on-click": "ghostty --title='btop-popup' -e btop",
        "states": {
            "warning": 10,
            "high": 30,
            "critical": 50
        },
    },
    "memory": {
        "interval": 30,
        "format": " mem {}%",
        "max-length": 10,
        "on-click": "ghostty --title='btop-popup' -e btop",
        "states": {
            "warning": 20,
            "high": 50,
            "critical": 70
        }
    },
    "clock": {
        "format": "{:%A, %B %d %H:%M} ",
        "format-alt": " {:%A  %e %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "network": {
        "format-wifi": "wiFi",
        "format-ethernet": "ethernet",
        "format-disconnected": "offline",
        "tooltip": true,
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}\n↓ {bandwidthDownBits}\n↑ {bandwidthUpBits}",
        "tooltip-format-ethernet": "IP: {ipaddr}\nGateway: {gwaddr}\n↓ {bandwidthDownBits}\n↑ {bandwidthUpBits}"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "on-click": "omarchy-menu power",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
    },
    "pulseaudio": {
        "format": " vol {volume}% ",
        "on-click": "wiremix",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "muted",
    },
    "group/tray-expander": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 600,
            "children-class": "tray-group-item"
        },
        "modules": [
            "custom/expand-icon",
            "tray"
        ]
    },
    "custom/expand-icon": {
        "format": "",
        "tooltip": false
    },
    "tray": {
        "icon-size": 12,
        "spacing": 8
    },
    "custom/blank": {
        "format": " ",
    },
    "custom/sep": {
        "format": "|",
    },
    "mpris": {
        "interval": 10,
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {artist} {title}",
        "on-click-middle": "playerctl play-pause",
        "on-click": "playerctl previous",
        "on-click-right": "playerctl next",
        "scroll-step": 5.0,
        "on-scroll-up": "$HOME/.config/hypr/scripts/volume.sh --inc",
        "on-scroll-down": "$HOME/.config/hypr/scripts/volume.sh --dec",
        "smooth-scrolling-threshold": 1,
        "tooltip": true,
        "tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
        "player-icons": {
            "chromium": "",
            "default": "",
            "firefox": "",
            "kdeconnect": "",
            "mopidy": "",
            "mpv": "󰐹",
            "spotify": "󰎆",
            "vlc": "󰕼",
        },
        "status-icons": {
            "paused": "",
            "playing": "",
            "stopped": "",
        },
        "dynamic-order": [
            "artist",
            "title"
        ],
        "ignored-players": [
            "firefox",
            "zen"
        ],
        "max-length": 40,
    },
}
